# Trigger ekleme

CREATE OR REPLACE FUNCTION set_page_number_to_null()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.page_number = 0 THEN
        NEW.page_number := NULL;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_set_page_number_to_null
BEFORE INSERT OR UPDATE ON library_item
FOR EACH ROW
EXECUTE FUNCTION set_page_number_to_null();


