#Library Item tablosu

CREATE TABLE library_item (
    id SERIAL PRIMARY KEY,         -- Kitap ID'si, otomatik artan birincil anahtar
    barcode VARCHAR(100) NOT NULL, -- Barkod bilgisi, maksimum 100 karakter
    title VARCHAR(200) NOT NULL,   -- Kitap başlığı, maksimum 200 karakter
    author VARCHAR(150) NOT NULL,  -- Yazar adı, maksimum 150 karakter
    page_number INT ,      -- Sayfa sayısı, tam sayı
    available BOOLEAN DEFAULT TRUE -- Kullanılabilirlik bilgisi, varsayılan TRUE
	library_item varchar(50) not null
);

